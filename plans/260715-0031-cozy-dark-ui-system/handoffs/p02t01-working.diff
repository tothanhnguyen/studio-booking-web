+.ui-action {
+  display: inline-flex;
+  min-height: 3rem;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm);
+  padding: 0.75rem 1.125rem;
+  color: var(--color-bone);
+  font: inherit;
+  font-size: 0.875rem;
+  font-weight: 700;
+  line-height: 1.25;
+  text-align: center;
+  text-decoration: none;
+  cursor: pointer;
+  transition:
+    background-color var(--motion-fast) ease,
+    border-color var(--motion-fast) ease,
+    color var(--motion-fast) ease,
+    transform var(--motion-fast) ease;
+}
+
+.ui-action--compact {
+  min-height: 2.75rem;
+  padding: 0.5rem 0.875rem;
+}
+
+.ui-action--primary {
+  background: var(--color-champagne);
+  color: var(--color-void);
+}
+
+.ui-action--secondary {
+  border-color: var(--color-warm-line);
+  background: transparent;
+}
+
+.ui-action--tertiary {
+  background: transparent;
+  color: var(--color-brass);
+}
+
+.ui-action--danger {
+  border-color: var(--color-clay);
+  background: rgb(201 143 124 / 16%);
+  color: var(--color-bone);
+}
+
+.ui-action:active { transform: scale(0.98); }
+.ui-action:disabled,
+.ui-action[aria-disabled="true"] { cursor: not-allowed; opacity: 0.5; }
+
+.page-heading {
+  display: grid;
+  max-width: 52rem;
+  gap: 0.75rem;
+}
+
+.page-heading h1,
+.empty-state h2 {
+  margin: 0;
+  color: var(--color-bone);
+  letter-spacing: -0.04em;
+  line-height: 1.08;
+}
+
+.page-heading--default h1 { font-size: clamp(2rem, 5vw, 3.75rem); }
+.page-heading--large h1 { font-size: clamp(2.75rem, 7vw, 5.5rem); }
+
+.page-eyebrow {
+  margin: 0;
+  color: var(--color-brass);
+  font-family: var(--font-mono), monospace;
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+}
+
+.page-description {
+  max-width: 42rem;
+  margin: 0;
+  color: var(--color-smoke);
+  font-size: clamp(1rem, 2vw, 1.125rem);
+  line-height: 1.7;
+}
+
+.ui-surface {
+  border: 1px solid var(--color-warm-line);
+  border-radius: var(--radius-md);
+  background: var(--color-espresso);
+  padding: clamp(1.25rem, 3vw, 2rem);
+}
+
+.room-visual {
+  --room-material-glow: rgb(168 162 158 / 14%);
+
+  position: relative;
+  aspect-ratio: 13 / 12;
+  overflow: hidden;
+  margin: 0;
+  border: 1px solid var(--color-warm-line);
+  border-radius: var(--radius-lg);
+  background: var(--color-espresso);
+}
+
+.room-visual[data-room-material="photo"] {
+  --room-material-glow: rgb(239 210 160 / 18%);
+}
+
+.room-visual[data-room-material="music"] {
+  --room-material-glow: rgb(143 165 142 / 18%);
+}
+
+.room-visual::after {
+  position: absolute;
+  z-index: 1;
+  inset: 0;
+  box-shadow: inset 0 0 2.5rem var(--room-material-glow);
+  content: "";
+  pointer-events: none;
+}
+
+.room-visual img {
+  object-fit: cover;
+  transition: transform var(--motion-base) ease;
+}
+
+.room-visual:focus-within img { transform: scale(1.025); }
+
+.facts-rail {
+  display: grid;
+  grid-template-columns: 1fr;
+  border-block: 1px solid var(--color-warm-line);
+}
+
+.facts-rail > * {
+  min-width: 0;
+  padding: 1rem;
+}
+
+.facts-rail > * + * { border-block-start: 1px solid var(--color-warm-line); }
+
+.empty-state {
+  display: grid;
+  justify-items: center;
+  gap: 0.75rem;
+  border: 1px solid var(--color-warm-line);
+  border-radius: var(--radius-md);
+  background: var(--color-espresso);
+  padding: clamp(2rem, 7vw, 4rem);
+  text-align: center;
+}
+
+.empty-state h2 { font-size: clamp(1.5rem, 4vw, 2.25rem); }
+.empty-state p { max-width: 36rem; margin: 0; color: var(--color-smoke); line-height: 1.7; }
+.empty-state__action { margin-top: 0.5rem; }
+
+@media (hover: hover) {
+  .ui-action--primary:hover { background: var(--color-bone); }
+  .ui-action--secondary:hover { border-color: var(--color-brass); color: var(--color-champagne); }
+  .ui-action--tertiary:hover { color: var(--color-champagne); }
+  .ui-action--danger:hover { background: rgb(201 143 124 / 26%); }
+  .room-visual:hover img { transform: scale(1.025); }
+}
+
+@media (min-width: 640px) {
+  .facts-rail {
+    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
+  }
+
+  .facts-rail > * + * {
+    border-block-start: 0;
+    border-inline-start: 1px solid var(--color-warm-line);
+  }
+}
