@@ -0,0 +1,59 @@
+.ui-field {
+  display: grid;
+  gap: 0.5rem;
+}
+
+.ui-field label {
+  color: var(--color-bone);
+  font-size: 0.875rem;
+  font-weight: 650;
+}
+
+.ui-field :where(input, select, textarea) {
+  width: 100%;
+  min-height: 3rem;
+  border: 1px solid color-mix(in srgb, var(--color-brass) 40%, var(--color-warm-line));
+  border-radius: var(--radius-sm);
+  background: var(--color-espresso);
+  padding: 0.75rem 0.875rem;
+  color: var(--color-bone);
+  font: inherit;
+  transition:
+    border-color var(--motion-fast) ease,
+    box-shadow var(--motion-fast) ease,
+    background-color var(--motion-fast) ease;
+}
+
+.ui-field textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+.ui-field :where(input, textarea)::placeholder {
+  color: var(--color-smoke);
+  opacity: 0.78;
+}
+
+.ui-field :where(input, select, textarea):focus {
+  border-color: var(--color-brass);
+  box-shadow: 0 0 0 3px rgb(217 191 131 / 14%);
+}
+
+.ui-field :where(input, select, textarea)[aria-invalid="true"] {
+  border-color: var(--color-clay);
+}
+
+.ui-field :where(input, select, textarea):disabled {
+  cursor: not-allowed;
+  opacity: 0.55;
+}
+
+.ui-field__hint,
+.ui-field__error {
+  margin: 0;
+  font-size: 0.8125rem;
+  line-height: 1.5;
+}
+
+.ui-field__hint { color: var(--color-smoke); }
+.ui-field__error { color: var(--color-clay); }
