+export type ActionVariant = "primary" | "secondary" | "tertiary" | "danger";
+
+export function actionClassName(
+  variant: ActionVariant = "primary",
+  compact = false,
+) {
+  return [
+    "ui-action",
+    `ui-action--${variant}`,
+    compact ? "ui-action--compact" : "",
+  ]
+    .filter(Boolean)
+    .join(" ");
+}
