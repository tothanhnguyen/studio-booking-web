@@ -0,0 +1,24 @@
+import Link from "next/link";
+
+export const studioLinks = [
+  { href: "/studios/photo-studio", label: "Photo" },
+  { href: "/studios/voice-podcast-booth", label: "Podcast" },
+  { href: "/studios/music-studio", label: "Music" },
+] as const;
+
+export function SiteFooter() {
+  return (
+    <footer className="site-footer">
+      <div className="site-footer-inner">
+        <p className="site-footer-wordmark">MOW</p>
+        <nav aria-label="Điều hướng chân trang" className="site-footer-links">
+          {studioLinks.map((link) => (
+            <Link href={link.href} key={link.href}>{link.label}</Link>
+          ))}
+        </nav>
+        <Link className="site-footer-cta" href="/studios">Đặt lịch</Link>
+      </div>
+      <p className="site-footer-location">Sài Gòn · Asia/Ho_Chi_Minh</p>
+    </footer>
+  );
+}
diff --git a/src/styles/shell.css b/src/styles/shell.css
new file mode 100644
index 0000000..13635bc
--- /dev/null
+++ b/src/styles/shell.css
@@ -0,0 +1,199 @@
+.app-shell { display: flex; flex-direction: column; }
+.site-header {
+  position: sticky; top: 0; z-index: 40;
+  border-bottom: 1px solid var(--color-warm-line); background: var(--color-ink);
+}
+.app-shell:has(#home-hero) .site-header {
+  position: absolute; inset: 0 0 auto;
+  border-bottom-color: transparent;
+  background: linear-gradient(to bottom, rgb(7 8 7 / 92%), rgb(7 8 7 / 48%) 68%, transparent);
+}
+.app-shell:has(#home-hero) .app-main { max-width: none; padding: 0; }
+.app-shell:has(#home-hero) .site-footer { display: none; }
+.app-main { flex: 1; }
+.site-header-inner {
+  position: relative;
+  display: flex;
+  width: 100%; max-width: 92rem; min-height: 5rem;
+  margin-inline: auto;
+  align-items: center; justify-content: space-between; gap: 1.5rem;
+  padding-inline: clamp(1.5rem, 4.5vw, 4rem);
+}
+.site-wordmark {
+  display: inline-flex;
+  min-height: 2.75rem; align-items: center; gap: 0.55rem;
+  color: #fafaf9; line-height: 1;
+}
+.site-wordmark-primary {
+  font-size: 1.15rem; font-weight: 750; letter-spacing: -0.055em;
+}
+.site-wordmark-divider {
+  width: 1px; height: 1.5rem;
+  background: rgb(255 255 255 / 22%);
+}
+.site-wordmark-secondary {
+  color: #d9bf83; font-size: 0.58rem; font-weight: 600; letter-spacing: 0.24em;
+  writing-mode: vertical-rl; transform: rotate(180deg);
+}
+.site-wordmark:focus-visible,
+.site-nav a:focus-visible,
+.site-nav button:focus-visible,
+.site-mobile-menu summary:focus-visible,
+.site-mobile-menu a:focus-visible,
+.site-mobile-menu button:focus-visible,
+.site-footer a:focus-visible {
+  outline: 2px solid #d9bf83; outline-offset: 4px;
+}
+.site-nav,
+.site-room-links {
+  display: flex; align-items: center;
+}
+.site-nav { display: none; gap: clamp(0.75rem, 1.7vw, 1.5rem); }
+.site-room-links { display: none; gap: clamp(1rem, 2.2vw, 2rem); }
+.site-room-links a,
+.site-nav-auth-link {
+  position: relative; display: inline-flex;
+  min-height: 2.75rem; align-items: center;
+  color: #a8a29e; font-size: 0.875rem; font-weight: 500;
+  transition: color 180ms ease;
+}
+.site-room-links a {
+  gap: 0.4rem; padding-block: 0.75rem;
+}
+.site-room-links a:hover,
+.site-nav-auth-link:hover { color: #f5f5f4; }
+
+.site-nav-divider {
+  display: none; width: 1px; height: 1.25rem;
+  background: rgb(255 255 255 / 18%);
+}
+
+.site-nav-cta,
+.site-nav-logout {
+  display: inline-flex;
+  min-height: 2.75rem; align-items: center; justify-content: center;
+  border: 1px solid #efd2a0;
+  border-radius: 0.75rem; background: #efd2a0;
+  padding: 0.7rem 1rem;
+  color: #0c0a09; font-size: 0.875rem; font-weight: 650;
+  transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
+}
+
+.site-nav-cta:hover,
+.site-nav-logout:hover { background: #f7dfb5; color: #0c0a09; }
+.site-nav-cta:active,
+.site-nav-logout:active { transform: scale(0.97); }
+
+.site-nav-email {
+  display: none; max-width: 9rem; overflow: hidden;
+  color: var(--color-smoke); font-size: 0.75rem;
+  text-overflow: ellipsis; white-space: nowrap;
+}
+.site-mobile-menu { position: relative; }
+.site-mobile-menu summary {
+  display: inline-flex;
+  min-width: 4.5rem; min-height: 2.75rem;
+  cursor: pointer; list-style: none;
+  align-items: center; justify-content: center;
+  border: 1px solid var(--color-warm-line);
+  border-radius: var(--radius-sm); background: var(--color-ink);
+  color: var(--color-bone); font-size: 0.875rem; font-weight: 650;
+}
+
+.site-mobile-menu summary::-webkit-details-marker { display: none; }
+.site-mobile-menu[open] summary { border-color: var(--color-brass); }
+
+.site-mobile-menu nav {
+  position: absolute;
+  top: calc(100% + 0.75rem); right: 0;
+  display: flex;
+  width: min(20rem, calc(100vw - 3rem));
+  flex-direction: column; gap: 0.25rem;
+  border: 1px solid var(--color-warm-line);
+  border-radius: var(--radius-md); background: linear-gradient(145deg, var(--color-espresso), var(--color-ink));
+  padding: 0.75rem;
+  box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 38%);
+}
+
+.site-mobile-menu nav > a,
+.site-mobile-menu nav > form,
+.site-mobile-menu nav > form button { width: 100%; }
+
+.site-mobile-menu nav > a,
+.site-mobile-menu nav > form button {
+  display: flex; min-height: 2.75rem; align-items: center;
+  border-radius: var(--radius-sm);
+  padding-inline: 0.875rem;
+}
+
+.site-mobile-menu nav > a:not(.site-nav-cta):hover {
+  background: rgb(255 255 255 / 5%); color: var(--color-bone);
+}
+
+.site-mobile-menu .site-nav-email {
+  display: block; max-width: none;
+  padding: 0.5rem 0.875rem;
+}
+
+.site-footer {
+  border-top: 1px solid var(--color-warm-line); background: var(--color-ink);
+  padding: 2rem clamp(1.5rem, 4.5vw, 4rem);
+}
+
+.site-footer-inner {
+  display: grid;
+  width: 100%; max-width: var(--content-public);
+  margin-inline: auto;
+  align-items: center; gap: 1.5rem;
+}
+
+.site-footer-wordmark {
+  color: var(--color-bone); font-size: 1.25rem; font-weight: 750;
+  letter-spacing: -0.055em;
+}
+
+.site-footer-links {
+  display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
+}
+
+.site-footer-links a {
+  display: inline-flex;
+  min-height: 2.75rem; align-items: center;
+  color: var(--color-smoke); font-size: 0.875rem;
+}
+
+.site-footer-links a:hover { color: var(--color-bone); }
+
+.site-footer-cta {
+  display: inline-flex;
+  min-height: 2.75rem; align-items: center; justify-content: center;
+  border: 1px solid var(--color-champagne);
+  border-radius: var(--radius-sm); background: var(--color-champagne);
+  padding-inline: 1rem;
+  color: var(--color-ink); font-size: 0.875rem; font-weight: 650;
+}
+
+.site-footer-location {
+  width: 100%; max-width: var(--content-public);
+  margin: 1.5rem auto 0;
+  color: var(--color-smoke); font-size: 0.75rem;
+}
+
+@media (min-width: 640px) {
+  .site-nav { display: flex; }
+  .site-mobile-menu { display: none; }
+  .site-room-links,
+  .site-nav-divider { display: flex; }
+
+  .site-footer-inner {
+    grid-template-columns: auto 1fr auto;
+  }
+}
+
+@media (min-width: 1024px) {
+  .site-room-links {
+    position: absolute; left: 50%;
+    transform: translateX(-50%);
+  }
+  .site-nav-email { display: block; }
+}
